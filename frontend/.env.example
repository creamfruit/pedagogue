# Where the backend lives.
#
# Development (npm run dev): requests go to /api on the Vite dev server, which
# proxies them to this URL, so http://localhost:8000 is the usual value.
#
# Production (npm run build, npm run build:mobile): this is the only source of
# the API address. The build stops with an error if it is missing. Use the
# public HTTPS origin of the deployed backend with no trailing slash and no
# /api/v1, for example https://api.pedagogue.app. The website and the iOS and
# Android apps are all built with the same value, because the apps load the
# bundled files from capacitor://localhost or https://localhost and can only
# reach the backend through this absolute URL.
VITE_API_URL=http://localhost:8000

# Path prefix of the versioned API. Leave as is unless the backend's
# API_V1_PREFIX changes.
VITE_API_PREFIX=/api/v1

# Address shown on the privacy policy and terms pages for data and deletion
# requests. Leave empty to point people at the store listing instead.
VITE_CONTACT_EMAIL=
